# =============================================================
# sealog-server SOI — Docker development environment
# Sub (ROV Subastian vehicle server)
# Copy to .env.Sub and fill in SEALOG_SERVER_SECRET before use.
# =============================================================

SEALOG_INSTANCE_TYPE=Sub
NODE_ENV=development
MONGO_URL=mongodb://mongo:27017/sealogDB_Sub
SEALOG_SERVER_FILEPATH_ROOT=/data/sealog-files

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"
SEALOG_SERVER_SECRET=

# Camera status polling URLs (used by plugins/camera_status.js)
# SEALOG_SERVER_SCICAM_STATUS_URL=
# SEALOG_SERVER_SITCAM_STATUS_URL=

# Optional
# SEALOG_SERVER_PORT=8000
# SEALOG_SERVER_USE_ACCESS_CONTROL=false
# SEALOG_DISABLE_SELF_REGISTRATION=false
