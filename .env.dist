# ============================================================
# sealog-server SOI — environment variable template
# Copy to .env and fill in values before starting the server.
# .env is gitignored and must never be committed.
# ============================================================

# ------------------------------------------------------------------
# Required
# ------------------------------------------------------------------

# Instance type: FKt (R/V Falkor(too) vessel), Sub (ROV Subastian), emp (AUV Empress)
SEALOG_INSTANCE_TYPE=FKt

# Runtime environment.
# production  — connects to sealogDB, runs migrations only (never drops collections)
# development — connects to sealogDB_devel, drops and reseeds on every start
# debug       — connects to sealogDB, production behaviour with full request logging
# test        — like development, used by the test suite
NODE_ENV=production

# Full MongoDB connection URL.
# Use a separate database per instance when running multiple instances on one host.
MONGO_URL=mongodb://localhost:27017/sealogDB_FKt

# Root directory for cruise/lowering files and uploaded images.
# The server creates images/, cruises/, and lowerings/ subdirectories automatically.
SEALOG_SERVER_FILEPATH_ROOT=/opt/sealog-server/sealog-files

# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"
SEALOG_SERVER_SECRET=

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------

# HTTP/HTTPS listen port (default: 8000)
# SEALOG_SERVER_PORT=8000

# MongoDB database names (defaults shown)
# SEALOG_DB_NAME=sealogDB
# SEALOG_DB_DEVEL_NAME=sealogDB_devel

# Enable per-cruise/per-lowering user access control lists (default: false)
# SEALOG_SERVER_USE_ACCESS_CONTROL=false

# Prevent new users from self-registering (default: false)
# SEALOG_DISABLE_SELF_REGISTRATION=false

# TLS certificate paths — set both to enable HTTPS
# SEALOG_SERVER_TLS_PRIVKEY=/path/to/privkey.pem
# SEALOG_SERVER_TLS_FULLCHAIN=/path/to/fullchain.pem

# ------------------------------------------------------------------
# Email integration (uncomment the block matching config/email_settings.js)
# ------------------------------------------------------------------

# Gmail OAuth2
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_SERVER_URL=
# GMAIL_REFRESH_TOKEN=

# Mailgun
# MG_APIKEY=
# MG_DOMAIN=

# Mailjet
# MJ_APIKEY_PUBLIC=
# MJ_APIKEY_PRIVATE=
