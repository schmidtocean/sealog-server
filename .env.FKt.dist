# =============================================================
# sealog-server SOI — Docker development environment
# FKt (R/V Falkor(too) vessel server)
# Copy to .env.FKt and fill in SEALOG_SERVER_SECRET before use.
# =============================================================

SEALOG_INSTANCE_TYPE=FKt
NODE_ENV=development
MONGO_URL=mongodb://mongo:27017/sealogDB_FKt
SEALOG_SERVER_FILEPATH_ROOT=/data/sealog-files

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(256).toString('base64'));"
SEALOG_SERVER_SECRET=

# Optional
# SEALOG_SERVER_PORT=8000
# SEALOG_SERVER_USE_ACCESS_CONTROL=false
# SEALOG_DISABLE_SELF_REGISTRATION=false
