#!/usr/bin/env python3
'''
FILE:           sealog_cruise_sync.py

DESCRIPTION:    This script listens for new cruise records and cruise record updates
                and syncs those new/updated records with other sealog instances

BUGS:
NOTES:
AUTHOR:     Webb Pinner
COMPANY:    OceanDataTools.org
VERSION:    1.0
CREATED:    2021-04-21
REVISION:   2022-02-13

LICENSE INFO:   This code is licensed under MIT license (see LICENSE.txt for details)
                Copyright (C) OceanDataTools.org 2024
'''

import sys
import json
import logging
import asyncio
import websockets
import requests

from copy import deepcopy

from os.path import dirname, realpath
sys.path.append(dirname(dirname(realpath(__file__))))

from misc.python_sealog.settings import WS_SERVER_URL, HEADERS, CRUISES_API_PATH

CLIENT_WSID = 'cruiseSync'

HELLO = {
    'type': 'hello',
    'id': CLIENT_WSID,
    'auth': {
        'headers': HEADERS
    },
    'version': '2',
    'subs': ['/ws/status/newCruises', '/ws/status/updateCruises']
}

PING = {
    'type':'ping',
    'id':CLIENT_WSID
}

SEALOG_SERVER_INSTANCES = [
    {
        'apiServerURL': '',
        'token': ''
    }
]


def update_cruise_record(cruise_record, server_instances):
    '''
    Update the cruise record on the other sealog-servers/
    '''

    for instance in server_instances:
        # check to see if a cruise record with the cruiseID in cruise_record already exists

        instance_headers = {
            "authorization": instance['token']
        }

        try:
            cruise_found = None
            
            # Check if cruise exists on the remote server
            url = instance['apiServerURL'] + CRUISES_API_PATH + '/' + cruise_record['id']
            # Timeout to prevent the request from hanging indefinitely
            req = requests.get(url, headers=instance_headers, timeout=10)

            if req.status_code != 404:
                # This will raise an exception if HTTP err 500, 401 etc
                req.raise_for_status()
                logging.debug("Cruise found for Cruise UID: %s", cruise_record['id'])
                cruise_found = req.json()
            else:
                logging.debug("Cruise NOT found for Cruise UID: %s", cruise_record['id'])

            # If a cruise record with the cruiseID does exist, perform an update
            if cruise_found:
                update_url = instance['apiServerURL'] + CRUISES_API_PATH + '/' + cruise_found['id']
                update_data = deepcopy(cruise_record)
                del update_data['id']
                
                patch_req = requests.patch(update_url, headers=instance_headers, data=json.dumps(update_data), timeout=10)
                patch_req.raise_for_status() # Check for errors on the PATCH request
                logging.info(f"Successfully updated cruise {cruise_record['id']} on {instance['apiServerURL']}")
                logging.debug(patch_req.text)

            # If a cruise record with the cruiseID does NOT exist, perform insert
            else:
                insert_url = instance['apiServerURL'] + CRUISES_API_PATH
                
                post_req = requests.post(insert_url, headers=instance_headers, data=json.dumps(cruise_record), timeout=10)
                post_req.raise_for_status() # Check for errors on POST request
                logging.info(f"Successfully inserted cruise {cruise_record['id']} on {instance['apiServerURL']}")
                logging.debug(post_req.text)

        # Catch specific network exceptions
        except requests.exceptions.RequestException as error:
            # The 'raise' statement is removed. The script now logs the error and
            # continues to the next server instance if present
            logging.error(f"Could not connect to server {instance.get('apiServerURL', 'N/A')}: {error}")

        # Catch any other potential errors gracefully
        except Exception as error:
            logging.error(f"An unexpected error occurred while syncing with {instance.get('apiServerURL', 'N/A')}: {error}")


# -------------------------------------------------------------------------------------
# The main loop of the utility
# -------------------------------------------------------------------------------------
async def cruise_sync(server_instances):
    '''
    Listen to the newCruise and updateCruise subscriptions and call
    update_cruise_record whenever there is a change.
    '''

    # infinite outer loop added to handle reconnect
    while True:
        try:
            async with websockets.connect(WS_SERVER_URL) as websocket:
                logging.info("Successfully connected to WebSocket server.")
                await websocket.send(json.dumps(HELLO))

                # Inner loop for receiving messages while connected.
                while True:
                    try:
                        # Set a timeout on receiving messages to detect dead connections
                        cruise = await asyncio.wait_for(websocket.recv(), timeout=300.0)
                        cruise_obj = json.loads(cruise)

                        if cruise_obj.get('type') == 'ping':
                            await websocket.send(json.dumps(PING))
                        elif cruise_obj.get('type') == 'pub':
                            logging.debug(json.dumps(cruise_obj, indent=2))
                            logging.info("Updating cruise record on other sealog instances")
                            update_cruise_record(cruise_obj['message'], server_instances)
                        else:
                            logging.debug(f"Skipping message of type: {cruise_obj.get('type')}")
                    
                    except asyncio.TimeoutError:
                        logging.warning("WebSocket recv timed out. Sending a ping to check connection.")
                        try:
                            # If recv times out the connection might be stale
                            # Send a ping with a short timeout to confirm
                            await asyncio.wait_for(websocket.ping(), timeout=10)
                        except asyncio.TimeoutError:
                            logging.error("WebSocket ping timed out. Connection is likely dead.")
                            break # Exit inner loop to trigger reconnection

        # Catch specific websocket connection errors
        except (websockets.exceptions.ConnectionClosed, websockets.exceptions.InvalidURI, ConnectionRefusedError) as error:
            logging.error(f"WebSocket connection error: {error}. Retrying in 300 seconds...")
        
        # Catch any other unexpected exceptions
        except Exception as error:
            logging.error(f"An unexpected error occurred in the main loop: {error}. Retrying in 300 seconds...")
        
        # If exception occurs wait before reconnect
        await asyncio.sleep(300)

# -------------------------------------------------------------------------------------
# Required python code for running the script as a stand-alone utility
# -------------------------------------------------------------------------------------
if __name__ == '__main__':

    import argparse
    import os

    parser = argparse.ArgumentParser(description='Cruise Sync Service')
    parser.add_argument('-v', '--verbosity', dest='verbosity',
                                            default=0, action='count',
                                            help='Increase output verbosity')
    parser.add_argument('-f', '--server_instance_file',
                                            help='use the specifed server instance file')

    parsed_args = parser.parse_args()

    ############################
    # Set up logging before we do any other argument parsing (so that we
    # can log problems with argument parsing).

    LOGGING_FORMAT = '%(asctime)-15s %(levelname)s - %(message)s'
    logging.basicConfig(format=LOGGING_FORMAT)

    LOG_LEVELS = {0: logging.WARNING, 1: logging.INFO, 2: logging.DEBUG}
    parsed_args.verbosity = min(parsed_args.verbosity, max(LOG_LEVELS))
    logging.getLogger().setLevel(LOG_LEVELS[parsed_args.verbosity])

    server_instances = []

    if parsed_args.server_instance_file:

        try:
            with open(parsed_args.server_instance_file) as file:
                server_instances = json.load(file)

        except Exception as err:
            logging.error("Could not load server configurations from file")
            sys.exit(1)
    else:
        server_instances = SEALOG_SERVER_INSTANCES

    # Run the main loop
    try:
        asyncio.run(cruise_sync(server_instances))
    except KeyboardInterrupt:
        print('Interrupted')
        try:
            sys.exit(0)
        except SystemExit:
            os._exit(0) # pylint: disable=protected-access
