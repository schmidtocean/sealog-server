services:

  # -------------------------------------------------------------------------
  # R/V Falkor(too) vessel server — http://localhost:8000/sealog-server
  # -------------------------------------------------------------------------
  sealog-server-fkt:
    build:
      context: .
      dockerfile: Dockerfile
    depends_on:
      - mongo
    env_file:
      - .env.FKt
    image: sealog-server-fkt
    ports:
      - "8000:8000"
    restart: unless-stopped
    volumes:
      - sealog-files-fkt:/data/sealog-files

  # -------------------------------------------------------------------------
  # ROV Subastian vehicle server — http://localhost:8100/sealog-server
  # -------------------------------------------------------------------------
  sealog-server-sub:
    build:
      context: .
      dockerfile: Dockerfile
    depends_on:
      - mongo
    env_file:
      - .env.Sub
    image: sealog-server-sub
    ports:
      - "8100:8000"
    restart: unless-stopped
    volumes:
      - sealog-files-sub:/data/sealog-files

  # -------------------------------------------------------------------------
  # AUV Empress — http://localhost:8200/sealog-server
  # -------------------------------------------------------------------------
  sealog-server-emp:
    build:
      context: .
      dockerfile: Dockerfile
    depends_on:
      - mongo
    env_file:
      - .env.emp
    image: sealog-server-emp
    ports:
      - "8200:8000"
    restart: unless-stopped
    volumes:
      - sealog-files-emp:/data/sealog-files

  # -------------------------------------------------------------------------
  # Shared MongoDB — all three instances use separate databases
  # -------------------------------------------------------------------------
  mongo:
    image: mongo
    ports:
      - "27017:27017"
    volumes:
      - db_data:/data/db

volumes:
  db_data:
  sealog-files-fkt:
  sealog-files-sub:
  sealog-files-emp:
